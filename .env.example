# IRTH environment contract
# Copy to .env.local for local development and fill values locally.
# Never commit real secrets.

# Public Supabase configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase privileged key.
# Prefer SUPABASE_SECRET_KEY. SUPABASE_SERVICE_ROLE_KEY remains a compatibility fallback.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Public canonical site URL used by SEO/canonical/social metadata.
# Production must use the real HTTPS site origin, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=

# Server-only application origin used in transactional email links.
# Production must use the real HTTPS site origin.
IRTH_APP_URL=

# Server-only guest tracking HMAC secret. Minimum 32 characters.
IRTH_GUEST_TRACKING_SECRET=

# Server-only payout account encryption key.
# Must be a Base64-encoded 32-byte key for AES-256-GCM.
IRTH_PAYOUT_DATA_ENCRYPTION_KEY_V1=

# Transactional email transport (server-only)
RESEND_API_KEY=
IRTH_EMAIL_FROM=

# Protects the internal notification email processor endpoint.
# Minimum 32 characters.
IRTH_EMAIL_PROCESSOR_SECRET=

# Optional local/E2E Next.js dist directory override.
# IRTH_E2E_DIST_DIR=.next-e2e
